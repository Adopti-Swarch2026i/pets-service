# Variables consumidas por pets-service. Fuente unica de verdad para
# Docker Compose (cargado via env_file en Compose/docker-compose.yml).

# -- Base de datos relacional --
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/petsdb?sslmode=verify-full&sslrootcert=/app/certs/ca.crt

# -- Broker de eventos --
RABBITMQ_URL=amqps://adopti:${RABBITMQ_PASSWORD}@rabbitmq:5671/

# -- Firebase Admin (validacion de ID tokens) --
FIREBASE_CREDENTIALS=/firebase-config/adoptiswarch-dc4da-firebase-adminsdk-fbsvc-21e2ea6cae.json

# -- CORS --
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://localhost:8080,http://10.0.2.2
