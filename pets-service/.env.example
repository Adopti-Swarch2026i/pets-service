# Variables consumidas por pets-service. Fuente única de verdad para
# Docker Compose (cargado vía env_file en Compose/docker-compose.yml).
#
# Para correr el servicio FUERA de Docker, sustituir los hostnames Docker
# (postgres, rabbitmq) por localhost o el host correspondiente.

# ── Base de datos relacional ───────────────────────
DATABASE_URL=postgresql://postgres:password@postgres:5432/petsdb

# ── Broker de eventos ──────────────────────────────
RABBITMQ_URL=amqp://adopti:rabbitmq_secret@rabbitmq:5672/

# ── Firebase Admin (validación de ID tokens) ──────
# El compose monta el JSON en /firebase-config dentro del container.
# Reemplazar el nombre del archivo por el de tu service account.
FIREBASE_CREDENTIALS=/firebase-config/your-firebase-adminsdk.json

# ── CORS — orígenes permitidos ─────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://localhost:8080,http://10.0.2.2
