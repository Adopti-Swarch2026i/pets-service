FIREBASE_CREDENTIALS=../firebase-config/adoptiswarch-dc4da-firebase-adminsdk-fbsvc-21e2ea6cae.json
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# RabbitMQ — usado por el EventPublisher para emitir eventos del catálogo
# (pet.report.created, pet.report.updated, pet.report.reunited).
# En docker-compose se inyecta automáticamente; este valor solo aplica
# cuando se corre el servicio fuera de Docker.
RABBITMQ_URL=amqp://adopti:rabbitmq_secret@localhost:5672/

# Origenes permitidos para CORS (coma-separados). En docker-compose viene
# del .env raíz; se mantiene aquí para ejecución local.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://localhost:8080,http://10.0.2.2
